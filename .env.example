# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env repoya girmez.

# --- STT sağlayıcıları: ElevenLabs zorunlu, Groq isteğe bağlı yedek ---
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# --- Araçlar (proje içi taşınabilir ffmpeg) ---
FFMPEG_BIN=tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_BIN=tools/ffmpeg/bin/ffprobe.exe

# --- Kilometre taşı 1 (varsayılanlar; boş bırakılabilir) ---
# STT isteği zaman aşımı (sn). ElevenLabs aşarsa Groq denenir.
STT_TIMEOUT_S=60
# Güveni bu değerin altındaki kelimeler işaretlenir (0-1).
LOW_CONFIDENCE_THRESHOLD=0.80
# Konuşmasız bölüm dedektörü: none (varsayılan, K1) ya da silero.
NONSPEECH_DETECTOR=none
# MEDIA_DIR=data/media
MAX_UPLOAD_MB=500
MAX_DURATION_S=185
JOB_CONCURRENCY=3
